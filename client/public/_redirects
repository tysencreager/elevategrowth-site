# 301 Redirects for old/changed URLs
/meet-us /behind-elevate 301
/home / 301
/beginners-guide /blog 301

# SPA fallback for dynamic routes (e.g. /blog/:slug) that don't have
# pre-generated HTML files.  Static routes like /services, /contact, etc.
# are served directly from their pre-generated index.html files, so they
# don't need rewrite rules here.
/blog/* /index.html 200

# Catch-all: return 404 for any unmatched paths
/* /404.html 404
